.DS_Store
acceptance/evidence/tmp/
# Evidence binaries are never committed (issue #256): recordings, screenshots and
# hand-captured issue evidence live on the public R2 evidence bucket, uploaded via
# scripts/upload-evidence.mjs. Only text evidence (transcript, judge report) and
# the recordings index are tracked.
acceptance/evidence/recordings/*.gif
acceptance/evidence/recordings/*.webm
acceptance/evidence/recordings/*.pal.png
acceptance/evidence/recordings/.stage-*/
# The recorder's one-per-host pid lockfile (record.mjs, issue #250) and its reclaim graves.
acceptance/evidence/recordings/.lock*
acceptance/evidence/screenshots/
acceptance/evidence/issue-*/
acceptance/evidence/restyle-*/
packages/gui/screenshots/tmp/
.claude/settings.local.json
.claude/worktrees/
# Generated by scripts/sloc-report.mjs (npm run metrics --out / CI artifact) — never committed, so it can't go stale.
METRICS.md

# Local scratch: quick renderer screenshots for the issue #25 style grind (not tracked)
.tmp-shots/
